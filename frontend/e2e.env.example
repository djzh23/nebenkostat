# Local or deployed URL under test. Leave unset to start Nebenkostat on its dedicated local port.
PLAYWRIGHT_PORT=3100
# PLAYWRIGHT_BASE_URL=https://nebenkostat.de
# PLAYWRIGHT_SKIP_WEBSERVER=1
# Only set this when you have verified that the existing server is Nebenkostat.
# PLAYWRIGHT_REUSE_SERVER=1

# Authenticated E2E setup (never commit the real service-role key).
# Option A: reuse a previously saved Playwright state.
# E2E_STORAGE_STATE=playwright/.auth/user.json

# Option B: generate a temporary Supabase user and magic link automatically.
# E2E_SUPABASE_URL=https://your-project.supabase.co
# E2E_SUPABASE_SERVICE_ROLE_KEY=do-not-commit
# E2E_EMAIL=e2e@example.invalid
# 1 creates and removes an isolated user; 0 reuses the exact E2E_EMAIL without deleting it.
# E2E_CREATE_FRESH_USER=1
# For tests that create/delete objects or upload receipts, use a separate state path
# and enable the isolated mutation suite. The temporary user is removed afterwards.
# E2E_ISOLATED_MUTATIONS=1
# E2E_STORAGE_STATE=playwright/.auth/upload-user.json
# E2E_AUTH_MARKER=playwright/.auth/upload-ready

# Optional: use a one-time generated magic-link URL instead of the service role.
# E2E_MAGIC_LINK_URL=

# Optional checks.
E2E_LOAD_BUDGET_MS=5000
# VISUAL_REGRESSION=1
